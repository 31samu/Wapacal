{
  "name": "wapacal",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:suggestions": "node --test test/suggestions.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:native:private": "node scripts/build-native.mjs --private-seed",
    "test:build": "node --test test/build.mjs",
    "build": "npm run build:native",
    "test": "node --test test/calendar.test.mjs test/subscriptions.mjs test/build.mjs",
    "refresh": "node scripts/fetch.mjs",
    "test:native": "node --test test/native.mjs",
    "test:editor": "node --test test/editor.mjs",
    "test:native-ui": "node --test test/native-ui.mjs",
    "test:all": "node --test test/*.mjs",
    "format": "npm run format:web && npm run format:swift",
    "format:check": "npm run format:web:check && npm run format:swift:check",
    "format:web": "prettier --write \"{src,scripts,test}/**/*.{js,mjs,html,json}\" package.json config.example.json .prettierrc.json .swift-format",
    "format:web:check": "prettier --check \"{src,scripts,test}/**/*.{js,mjs,html,json}\" package.json config.example.json .prettierrc.json .swift-format",
    "format:swift": "xcrun swift-format format --in-place --recursive native test --configuration .swift-format",
    "format:swift:check": "xcrun swift-format lint --strict --recursive native test --configuration .swift-format",
    "package:release": "node scripts/package-release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "wapacal": {
    "bundleIdentifier": "com.samuelkremer.wapacal",
    "bundleVersion": 4
  },
  "dependencies": {
    "ical.js": "2.2.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "prettier": "3.6.2"
  },
  "license": "GPL-3.0-only"
}
